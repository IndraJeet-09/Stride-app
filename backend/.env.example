# Database
DATABASE_URL="postgres://postgres:postgres@localhost:5432/stride"

# Auth0
AUTH0_DOMAIN="your-tenant.auth0.com"
AUTH0_ISSUER_BASE_URL="https://your-tenant.auth0.com/"
AUTH0_AUDIENCE="https://api.stride.app"

# Strava OAuth
STRAVA_CLIENT_ID="your_strava_client_id"
STRAVA_CLIENT_SECRET="your_strava_client_secret"
STRAVA_REDIRECT_URI="http://localhost:4000/api/v1/integrations/strava/callback"

# App
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"

# CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"

# Token encryption (32-byte hex key for AES-256-GCM)
TOKEN_ENCRYPTION_KEY="your_64_char_hex_key_for_aes_256_gcm_encryption"

# Strava webhook
STRAVA_WEBHOOK_VERIFY_TOKEN="your_webhook_verify_token"

# Rate Limiting (optional - for production)
# RATE_LIMIT_REDIS_URL="redis://localhost:6379"

# Logging
LOG_LEVEL="info"
